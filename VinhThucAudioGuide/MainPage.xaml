<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:local="clr-namespace:VinhThucAudioGuide"
             x:Class="VinhThucAudioGuide.MainPage">

    <!-- Cấu trúc chia màn hình làm 5 phần -->
    <Grid RowDefinitions="Auto, 4*, Auto, 3*, Auto">

        <!-- 2. BẢN ĐỒ & NÚT GPS (Đã sửa thành Fill để tràn viền) -->
        <Grid Grid.Row="1">
            <mapsui:MapView x:Name="mapView" 
                            VerticalOptions="Fill" 
                            HorizontalOptions="Fill" />

            <Button x:Name="btnGps"
                    Text="📍 Vị trí"
                    FontAttributes="Bold"
                    TextColor="Black"
                    BackgroundColor="#F0F0F0"
                    CornerRadius="20"
                    WidthRequest="90"
                    HeightRequest="40"
                    Margin="15"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Shadow="{Shadow Brush=Black, Offset='0,2', Opacity=0.3}"
                    Clicked="MyLocation_Clicked" />
        </Grid>

        <!-- 3. TIÊU ĐỀ DANH SÁCH -->
        <Label x:Name="LblPoiListTitle" Grid.Row="2" Text="🍴 Danh sách món ăn" FontAttributes="Bold" FontSize="18" Margin="15,10,0,5" TextColor="White"/>

        <!-- 4. DANH SÁCH ĐỊA ĐIỂM -->
        <CollectionView x:Name="cvPoiList" 
                        Grid.Row="3" 
                        SelectionMode="Single" 
                        SelectionChanged="Poi_Selected" 
                        Margin="15,0">
            <CollectionView.EmptyView>
                <!-- Hiển thị khi danh sách POI rỗng (vd: offline lần đầu, server chưa có data) -->
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6" Padding="20">
                    <Label x:Name="LblPoiEmptyTitle" Text="Chưa có địa điểm nào." FontSize="14" HorizontalTextAlignment="Center" TextColor="#CCCCCC"/>
                    <Label x:Name="LblPoiEmptyHint" Text="Kiểm tra kết nối mạng và thử lại." FontSize="12" HorizontalTextAlignment="Center" TextColor="#9AA0A6"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- POI card: dùng DataTrigger theo IsSelected để chuyển sang giao diện tối khi được chọn.
                         Bấm lại đúng card đang chọn → IsSelected=false → trở về giao diện sáng. -->
                    <Border Padding="10" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BackgroundColor" Value="White"/>
                                <Setter Property="Stroke" Value="#E0E0E0"/>
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#1F1F1F"/>
                                        <Setter Property="Stroke" Value="#000000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid ColumnDefinitions="80, *">
                            <Border Grid.Column="0" WidthRequest="70" HeightRequest="70" BackgroundColor="#F5F5F5" Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="12,0,0,0">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                                <Label Text="{Binding Address}" FontSize="12" LineBreakMode="WordWrap" MaxLines="2">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="#777777"/>
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#CCCCCC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                                <HorizontalStackLayout Spacing="5" Margin="0,4,0,0">
                                    <Label Text="🟢 Active" FontSize="11" FontAttributes="Bold">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="TextColor" Value="#2e7d32"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#7CFF7C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 5. NÚT NGHE/DỪNG THUYẾT MINH -->
        <Grid Grid.Row="4" ColumnDefinitions="*, *" Margin="15,5,15,15" ColumnSpacing="15">
            <Button x:Name="BtnListen" Grid.Column="0" 
                    Text="🎧 Nghe thuyết minh" 
                    BackgroundColor="#2e7d32" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="8" 
                    HeightRequest="45"
                    Clicked="Speak_Clicked"/>

            <Button x:Name="BtnStop" Grid.Column="1" 
                    Text="⏹️ Dừng" 
                    BackgroundColor="#c62828" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="8" 
                    HeightRequest="45"
                    Clicked="StopSpeech_Clicked"/>
        </Grid>

    </Grid>
</ContentPage>