@model Shared.DTOs.Common.PagedResult<Shared.DTOs.DevicePreferences.DevicePreferenceDetailDto>
@{
    ViewData["Title"] = "Quản lý thiết bị";
}

@section Styles {
<style>
    :root {
        --cream: #f7f3ed; --cream-dark: #ede8df; --ivory: #faf8f4;
        --navy: #1e2d40; --navy-mid: #2c3e55; --navy-light: #3d5068;
        --gold: #b8964e; --gold-light: #d4ae6a; --gold-pale: #f0e4c8;
        --text-dark: #1e2d40; --text-mid: #4a5568; --text-light: #718096;
        --border: #d9cfc2;
        --shadow-sm: 0 1px 4px rgba(30,45,64,0.07);
        --shadow-md: 0 4px 16px rgba(30,45,64,0.10);
        --radius: 10px; --radius-sm: 6px;
    }

    .breadcrumb { background: transparent; padding: 0 0 12px; margin-bottom: 20px; font-size: 13px; }
    .breadcrumb-item a { color: var(--text-mid); text-decoration: none; transition: color 0.15s; }
    .breadcrumb-item a:hover { color: var(--gold); }

    .page-header {
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
        border-radius: var(--radius); padding: 28px 40px; margin-bottom: 20px;
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 16px; box-shadow: var(--shadow-md);
    }
    .page-header h1 { font-size: 1.9rem; font-weight: 700; color: var(--cream); margin: 0; display: flex; align-items: center; gap: 12px; }
    .page-header h1 i { color: var(--gold-light); }
    .page-header .lead { font-size: 13.5px; color: rgba(247,243,237,0.7); margin: 0; }

    .search-row { display: flex; gap: 12px; margin-bottom: 22px; align-items: center; }
    .search-input { flex: 1; padding: 10px 16px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 14px; outline: none; transition: border-color 0.2s; }
    .search-input:focus { border-color: var(--gold); }
    .btn-search { background: var(--navy); color: white; border: none; padding: 10px 24px; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .btn-search:hover { background: var(--navy-mid); }

    .table-card { background: var(--ivory); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; }
    .table { margin: 0; font-size: 13.5px; }
    .table thead { background: var(--cream-dark); }
    .table thead th { font-size: 11.5px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-mid); padding: 12px 16px; }
    .table tbody td { padding: 14px 16px; vertical-align: middle; border-bottom: 1px solid var(--border); background: #fff; }

    .platform-cell { display: flex; align-items: center; gap: 7px; }
    .bi-android2 { color: #3db05b; }
    .bi-apple { color: var(--navy-light); }

    .device-id { font-family: monospace; font-size: 12px; background: var(--cream-dark); padding: 2px 8px; border-radius: 4px; color: var(--navy-light); }
    
    .status-badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .status-online { background: rgba(58,125,79,0.1); color: #3a7d4f; border: 1px solid rgba(58,125,79,0.2); }
    .status-offline { background: rgba(113,128,150,0.1); color: var(--text-mid); border: 1px solid rgba(113,128,150,0.2); }

    .pagination { display: flex; justify-content: center; gap: 8px; margin-top: 24px; }
    .page-link { padding: 8px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-dark); text-decoration: none; transition: all 0.2s; }
    .page-link.active { background: var(--navy); color: white; border-color: var(--navy); }
    .page-link:hover:not(.active) { background: var(--gold-pale); border-color: var(--gold); }

    .btn-reset { padding: 6px; border-radius: 4px; border: 1px solid var(--border); background: #fff; color: var(--text-mid); cursor: pointer; transition: all 0.2s; }
    .btn-reset:hover { border-color: #a2493a; color: #a2493a; background: rgba(162,73,58,0.05); }
</style>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Admin</a></li>
        <li class="breadcrumb-item active">Quản lý thiết bị</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <h1><i class="bi bi-phone"></i>Quản lý thiết bị</h1>
        <p class="lead">Danh sách toàn bộ thiết bị đã từng kết nối với hệ thống.</p>
    </div>
    <div class="text-end">
        <div style="color: rgba(255,255,255,0.7); font-size: 13px;">Tổng cộng</div>
        <div style="color: var(--gold-light); font-size: 24px; font-weight: 700;">@Model.TotalCount</div>
    </div>
</div>

<form method="get" class="search-row">
    <input type="text" name="search" value="@ViewBag.Search" class="search-input" placeholder="Tìm kiếm theo Device ID, Model hoặc Nhà sản xuất...">
    <button type="submit" class="btn-search">Tìm kiếm</button>
</form>

<div class="table-card">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Nền tảng</th>
                    <th>Thiết bị</th>
                    <th>Device ID</th>
                    <th>Ngôn ngữ</th>
                    <th>Lần đầu thấy</th>
                    <th>Hoạt động cuối</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">Không tìm thấy thiết bị nào.</td>
                    </tr>
                }
                else
                {
                    foreach (var d in Model.Items)
                    {
                        var isAndroid = string.Equals(d.Platform, "Android", StringComparison.OrdinalIgnoreCase);
                        var isIos = string.Equals(d.Platform, "iOS", StringComparison.OrdinalIgnoreCase);
                        var iconCls = isAndroid ? "bi-android2" : isIos ? "bi-apple" : "bi-phone";
                        var isOnline = (DateTimeOffset.UtcNow - d.LastSeenAt).TotalSeconds < 60;
                        
                        <tr>
                            <td>
                                <span class="platform-cell">
                                    <i class="bi @iconCls"></i>
                                    @(d.Platform ?? "—")
                                </span>
                            </td>
                            <td>
                                <div>@d.DeviceModel</div>
                                <div style="font-size: 11px; color: var(--text-light)">@d.Manufacturer</div>
                            </td>
                            <td><code class="device-id">@d.DeviceId</code></td>
                            <td>
                                <span style="font-size: 12px;">@d.LanguageName</span>
                                <div style="font-size: 11px; color: var(--text-light)">@d.LanguageCode</div>
                            </td>
                            <td style="font-size: 12px; color: var(--text-mid)">@d.FirstSeenAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="font-size: 12px; color: var(--text-mid)">@d.LastSeenAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (isOnline)
                                {
                                    <span class="status-badge status-online">Online</span>
                                }
                                else
                                {
                                    <span class="status-badge status-offline">Offline</span>
                                }
                            </td>
                            <td>
                                <button class="btn-reset" onclick="resetDevice('@d.DeviceId')" title="Yêu cầu reset thiết bị">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalCount > Model.PageSize)
{
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
    <div class="pagination">
        @for (int i = 1; i <= totalPages; i++)
        {
            <a href="?page=@i&search=@ViewBag.Search" class="page-link @(i == Model.Page ? "active" : "")">@i</a>
        }
    </div>
}

@section Scripts {
<script>
    async function resetDevice(deviceId) {
        if (!confirm('Bạn có chắc muốn yêu cầu thiết bị này reset lại dữ liệu?')) return;
        
        try {
            const res = await fetch(`/Admin/ResetDevice?deviceId=${encodeURIComponent(deviceId)}`, { method: 'POST' });
            const json = await res.json();
            if (json.success) {
                alert('Đã gửi yêu cầu reset thành công!');
            } else {
                alert('Lỗi: ' + json.message);
            }
        } catch (e) {
            alert('Lỗi kết nối API.');
        }
    }
</script>
}
